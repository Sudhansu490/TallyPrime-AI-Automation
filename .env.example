# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# false = log only to data/logs/app.log (deploy/run-app.ps1 sets this itself).
LOG_TO_CONSOLE=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Storage (relative paths resolve against the project root) ---
DATA_DIR=data
DATABASE_URL=sqlite:///data/tally_automation.db
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
# Images above this size are rejected (decompression-bomb guard).
MAX_IMAGE_MEGAPIXELS=50

# --- Processing: PDF text extraction and OCR (Phase 3) ---
# Runs inside the app process, one document at a time.
PROCESSING_WORKER_ENABLED=true
PROCESSING_POLL_SECONDS=2
# PDF pages whose embedded text has fewer letters/digits than this are OCR'd.
OCR_MIN_TEXT_CHARS=25
# DPI used to render PDF pages for OCR.
OCR_RENDER_DPI=300
# Longest image side used by the OCR text detector (PaddleOCR default is 960).
OCR_DET_MAX_SIDE=2000
# OCR lines below this confidence (0-1) are flagged for review.
OCR_LOW_CONFIDENCE=0.85

# --- Web server (one process: JSON API + HTML pages + static files) ---
# Comma-separated IP addresses to listen on. Only loopback and Tailscale
# addresses (100.64.0.0/10, fd7a:115c:a1e0::/48) are accepted; 0.0.0.0 and
# LAN/public addresses are refused at startup.
# To let Computer B connect, add Computer A's Tailscale IP (`tailscale ip -4`):
#   BIND_HOSTS=127.0.0.1,100.x.y.z
# Create at least one user first (see below): every page needs a login.
BIND_HOSTS=127.0.0.1
APP_PORT=8000
# Extra Host-header names to accept, e.g. Computer A's MagicDNS name.
# Loopback names and BIND_HOSTS are always accepted.
EXTRA_ALLOWED_HOSTS=
# Client devices allowed to connect at all (CIDRs; loopback or Tailscale ranges only).
# Default: this computer and any device on the tailnet. To admit only Computer A
# and Computer B, list their Tailscale IPs, e.g. 127.0.0.1/32,100.111.30.101/32,100.x.y.z/32
ALLOWED_CLIENT_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48

# --- Login and sessions (Phase 9) ---
# Users are managed on Computer A only:
#   python -m tally_automation users create NAME --role admin
#   python -m tally_automation users list | set-password NAME | set-role NAME ROLE | deactivate NAME | unlock NAME
# Roles: viewer < reviewer < approver < admin.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
# true = a voucher must be approved by someone other than the person who generated it.
REQUIRE_SEPARATE_APPROVER=false

# --- Backups and deployment (Phase 10) ---
# python -m tally_automation backup  (the startup task installer also schedules it daily).
# Blank = data/backups. Better: another drive or disk, e.g. D:\TallyAutomationBackups
BACKUP_DIR=
# Number of database copies kept (documents are copied once, by content).
BACKUP_KEEP=14

# --- LLM extraction (Phase 4) ---
# Leave LLM_PROVIDER blank to disable AI extraction: documents then stop at
# "text extracted" and no document text leaves this computer. When set, the
# text of every processed document is sent to this provider.
# Supported: groq
LLM_PROVIDER=groq
# Blank = provider default (groq: openai/gpt-oss-120b, strict JSON-schema output).
LLM_MODEL=
# Used only while LLM_MODEL is over its DAILY limit (each Groq model has its own
# daily quota). Less accurate: such documents get a review warning. Blank = none.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Optional: another Groq account's key, used only after BOTH models above are over
# their daily limit on LLM_API_KEY; the app goes back to LLM_API_KEY once it is free.
LLM_API_KEY_SECONDARY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# gpt-oss reasoning effort: low | medium | high (higher = slower, more careful).
LLM_REASONING_EFFORT=medium
# Transient failures (timeouts, rate limits, 5xx) are retried this many times.
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=32000
# Pages per LLM call. Long statements are split so output is never truncated.
LLM_PAGES_PER_CALL=3
# Fields the model reports below this confidence (0-1) are flagged for review.
LLM_LOW_CONFIDENCE=0.8

# --- TallyPrime (used from Phase 6) ---
# Tailscale hostname or 100.x.y.z IP of the TallyPrime host. Never a public address.
TALLY_HOST=
TALLY_PORT=9000
# Seconds for connection checks; master exports (thousands of ledgers) get longer.
TALLY_TIMEOUT_SECONDS=15
TALLY_EXPORT_TIMEOUT_SECONDS=120
# Responses larger than this are refused.
TALLY_MAX_RESPONSE_MB=100
# Optional: company pre-selected on the TallyPrime page (exact name as loaded in Tally).
TALLY_COMPANY=
# Hard safety switch. Voucher import is impossible while this is false.
TALLY_WRITE_ENABLED=false
