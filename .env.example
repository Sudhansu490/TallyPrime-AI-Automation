# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Storage (relative paths resolve against the project root) ---
DATA_DIR=data
DATABASE_URL=sqlite:///data/tally_automation.db
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
# Images above this size are rejected (decompression-bomb guard).
MAX_IMAGE_MEGAPIXELS=50

# --- Processing: PDF text extraction and OCR (Phase 3) ---
# Runs inside the app process, one document at a time.
PROCESSING_WORKER_ENABLED=true
PROCESSING_POLL_SECONDS=2
# PDF pages whose embedded text has fewer letters/digits than this are OCR'd.
OCR_MIN_TEXT_CHARS=25
# DPI used to render PDF pages for OCR.
OCR_RENDER_DPI=300
# Longest image side used by the OCR text detector (PaddleOCR default is 960).
OCR_DET_MAX_SIDE=2000
# OCR lines below this confidence (0-1) are flagged for review.
OCR_LOW_CONFIDENCE=0.85

# --- Web server (one process: JSON API + HTML pages + static files) ---
# Comma-separated IP addresses to listen on. Only loopback and Tailscale
# addresses (100.64.0.0/10, fd7a:115c:a1e0::/48) are accepted; 0.0.0.0 and
# LAN/public addresses are refused at startup.
# To let Computer B connect, add Computer A's Tailscale IP (`tailscale ip -4`):
#   BIND_HOSTS=127.0.0.1,100.x.y.z
# Do this only once login exists (Phase 9) or on a tailnet you fully control.
BIND_HOSTS=127.0.0.1
APP_PORT=8000
# Extra Host-header names to accept, e.g. Computer A's MagicDNS name.
# Loopback names and BIND_HOSTS are always accepted.
EXTRA_ALLOWED_HOSTS=

# --- LLM extraction (used from Phase 4) ---
# Supported values are defined in Phase 4. Leave blank until then.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- TallyPrime (used from Phase 6) ---
# Tailscale hostname or 100.x.y.z IP of the TallyPrime host. Never a public address.
TALLY_HOST=
TALLY_PORT=9000
TALLY_TIMEOUT_SECONDS=15
TALLY_COMPANY=
# Hard safety switch. Voucher import is impossible while this is false.
TALLY_WRITE_ENABLED=false
