# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Storage (relative paths resolve against the project root) ---
DATA_DIR=data
DATABASE_URL=sqlite:///data/tally_automation.db
MAX_UPLOAD_SIZE_MB=20

# --- Backend API ---
# Keep the API on loopback. Only the Streamlit UI is reached from Computer B.
API_HOST=127.0.0.1
API_PORT=8000
# URL the Streamlit server uses to call the API (server-side, same machine).
API_BASE_URL=http://127.0.0.1:8000

# --- LLM extraction (used from Phase 4) ---
# Supported values are defined in Phase 4. Leave blank until then.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- TallyPrime (used from Phase 6) ---
# Tailscale hostname or 100.x.y.z IP of the TallyPrime host. Never a public address.
TALLY_HOST=
TALLY_PORT=9000
TALLY_TIMEOUT_SECONDS=15
TALLY_COMPANY=
# Hard safety switch. Voucher import is impossible while this is false.
TALLY_WRITE_ENABLED=false
